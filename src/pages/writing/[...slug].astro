---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	// An entry with `url` lives elsewhere; building a page for it would produce
	// an empty one at /writing/<slug>.
	const posts = await getCollection('writing', ({ data }) => !data.draft && !data.url);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
	d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={post.data.title} description={post.data.description ?? post.data.title}>

	<header class="wrap page-head">
		<h1>{post.data.title}</h1>
		<p class="lede">
			<time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
			{post.data.description && <> · {post.data.description}</>}
		</p>
	</header>

	<article class="wrap block prose post-body">
		<Content />
	</article>

	<div class="wrap block">
		<p class="note"><a href="/writing">← All writing</a></p>
	</div>

</Base>
