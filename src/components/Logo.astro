---
/**
 * The S monogram: an angular S cut from three strokes with chamfered joins,
 * so the diagonal reads as a deliberate spine rather than a curve.
 * Stroked in currentColor, so it takes the theme with it.
 */
interface Props {
	size?: number;
	class?: string;
}
const { size = 20, class: cls = '' } = Astro.props;
---

<svg
	class={`logo ${cls}`}
	width={size}
	height={size}
	viewBox="0 0 100 100"
	aria-hidden="true"
	focusable="false"
	xmlns="http://www.w3.org/2000/svg"
>
	<path
		d="M80 24 H36 L22 38 L78 64 L64 78 H20"
		fill="none"
		stroke="currentColor"
		stroke-width="15"
		stroke-linecap="butt"
		stroke-linejoin="bevel"
	/>
</svg>
